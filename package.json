{
  "name": "dsh-omp-retry",
  "version": "0.2.1",
  "description": "OMP-style retry policies for the DeepSeek Harness: 429 rate limits and thinking-block binding rejections",
  "license": "MIT",
  "author": "Rinai-R",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rinai-R/dsh-omp-retry.git"
  },
  "homepage": "https://github.com/Rinai-R/dsh-omp-retry#readme",
  "bugs": {
    "url": "https://github.com/Rinai-R/dsh-omp-retry/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "retry",
    "rate-limit",
    "429",
    "thinking-block",
    "bedrock",
    "omp"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
